<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.humanjava.PRPO.inkcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/epson-ink-check</string>
    <string>--quiet</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>21600</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/prpo-inkcheck.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/prpo-inkcheck.log</string>
</dict>
</plist>
