#!/bin/sh
# PRPO — Presto-Reverso-Print-O control CLI.
# Run your Epson printer/scanner natively on Apple-silicon macOS, no Intel bloatware.
# (A lowercase `prpo` alias is installed too, so either spelling works.)

AGENTS="$HOME/Library/LaunchAgents"
BAR_AGENT="com.humanjava.PRPO.menubar"
INK_AGENT="com.humanjava.PRPO.inkcheck"

usage() {
  cat <<EOF
PRPO (presto-reverso-print-o) $(prpo_version)

  PRPO status             show current ink levels
  PRPO check              run the low-ink check now (notifies if low)
  PRPO menubar on|off     enable/disable the menu-bar indicator
  PRPO menubar status     is the indicator running?
  PRPO scan [file.pdf]    scan the flatbed to PDF via driverless eSCL
  PRPO version

Printer is auto-detected; override with EPSON_IPP_URI=ipps://host:631/ipp/print
EOF
}

prpo_version() { echo "0.1.0"; }

bar_on()  { launchctl bootstrap "gui/$(id -u)" "$AGENTS/$BAR_AGENT.plist" 2>/dev/null \
              || launchctl load "$AGENTS/$BAR_AGENT.plist" 2>/dev/null; echo "menu-bar indicator: on"; }
bar_off() { launchctl bootout "gui/$(id -u)/$BAR_AGENT" 2>/dev/null \
              || launchctl unload "$AGENTS/$BAR_AGENT.plist" 2>/dev/null; echo "menu-bar indicator: off"; }

case "$1" in
  status)  epson-ink-check --show ;;
  check)   epson-ink-check ;;
  menubar)
    case "$2" in
      on)     bar_on ;;
      off)    bar_off ;;
      status) launchctl list 2>/dev/null | grep -q "$BAR_AGENT" && echo "running" || echo "stopped" ;;
      *)      echo "usage: PRPO menubar on|off|status" ;;
    esac ;;
  scan)            PRPO-scan "$2" ;;
  version|-v|--version) prpo_version ;;
  *)               usage ;;
esac
